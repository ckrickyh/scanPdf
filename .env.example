# ==============================================================================
# 資料庫連線目標切換：可設定為 'local' 或 'supabase'
# ==============================================================================
DB_TARGET=supabase

# 1. 本地 PostgreSQL 連線字串
LOCAL_PG_CONN_STRING="postgresql://postgres:postgres@localhost:5432/scan_pdf_rag"

# 2. 線上 Supabase PostgreSQL 連線字串 (建議使用 Session Pooler 5432 或 Transaction Pooler 6543)
# 注意：Supabase 必須帶入 ?sslmode=require
# 請至 Supabase 控制台：Project Settings -> Database -> Connection string -> URI 取得
SUPABASE_PG_CONN_STRING="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?sslmode=require"

# 3. 嵌入模型與本地推論服務設定
EMBEDDING_MODEL="bge-m3"
OLLAMA_BASE_URL="http://localhost:11434"

# 4. Google Gemini LLM API 設定
# 支援 GEMINI_API_KEY 或 GOOGLE_API_KEY
GEMINI_API_KEY="your api key"
GEMINI_MODEL="gemini-2.5-flash"
